# ParlantRAG 环境变量配置模板
# 复制此文件为 .env 并填写实际值。
# 优先读取 LLM_* 系列变量；同时向后兼容 QWEN3_* / OPENAI_* 等命名。

# ==============================================================================
# LLM 配置（用于 LLMEvaluator — 参考 temp/llm/llm_client.py）
# ==============================================================================
LLM_API_KEY=sk-xxxx
LLM_BASE_URL=http://10.x.x.x:18023/v1
LLM_MODEL=Qwen2.5-7B-Instruct
# LLM_TEMPERATURE=0.0
# LLM_MAX_TOKENS=4096
# LLM_ENABLE_THINKING=false   # 推理模型（Qwen3/DeepSeek-R1）专用，禁用链式思考输出

# ==============================================================================
# Embedding 配置（用于 FlexRAGRetriever — 须与构建知识库时一致）
# ==============================================================================
EMBEDDING_BASE_URL=http://10.x.x.x:8018/v1
EMBEDDING_API_KEY=sk-xxxx
EMBEDDING_MODEL=Qwen3-Embedding-0.6B

# ==============================================================================
# 知识库路径（FlexRAG 构建并持久化的 FAISS 索引目录）
# ==============================================================================
KNOWLEDGE_PERSIST_DIR=./knowledge_base
