# ParlantRAG 环境变量配置
# 复制此文件为 .env 并填写实际值。
# 命名与 temp/llm/.env 保持一致，QWEN3_* 系列变量优先读取。

# ==============================================================================
# LLM 配置（Qwen3 / vLLM — 用于 LLMEvaluator，参考 temp/llm/.env）
# ==============================================================================
QWEN3_API_KEY=sk-your-api-key-here
QWEN3_BASE_URL=http://YOUR_LLM_SERVER_IP:18023/v1
QWEN3_MODEL=Qwen2.5-7B-Instruct
QWEN3_MAX_TOKENS=8192
# QWEN3_TEMPERATURE=0.0   # 默认 0.0（评估时使用确定性输出）

# ==============================================================================
# Embedding 配置（用于 FlexRAGRetriever — 须与构建知识库时的模型一致）
# 使用本地 sentence-transformers 模式（与 temp/embedding.py 一致），无需启动 Embedding 服务。
# EMBEDDING_MODEL_PATH 为必填项。
# ==============================================================================
EMBEDDING_MODEL_PATH=/path/to/your/models/BAAI/bge-large-zh-v1.5
EMBEDDING_MODEL=bge-large-zh-v1.5

# ==============================================================================
# 知识库路径（FlexRAG 构建并持久化的 FAISS 索引目录）
# 指向具体的索引子目录（含 faiss_index.bin / docstore.json 等文件）
# 例：FlexRAG 构建后的结构为 knowledge_base/knowledge_persist_dir/<dataset>/
# ==============================================================================
KNOWLEDGE_PERSIST_DIR=./knowledge_base/knowledge_persist_dir/hotpotqa