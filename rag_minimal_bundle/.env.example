# -----------------------------
# RAG index path (required)
# -----------------------------
# Can be a persist directory or a direct index path
# (supports faiss_index.bin/faiss_index + docstore)
KNOWLEDGE_PERSIST_DIR=./knowledge_base/knowledge_persist_dir/hotpotqa
# KNOWLEDGE_BASE_PATH=./knowledge_base/knowledge_persist_dir/hotpotqa

# Optional retrieval defaults
TOP_K=5
VECTOR_DB_COLLECTION=plan_a

# -----------------------------
# Embedding (choose one mode)
# -----------------------------
# Mode A: local embedding model
# EMBEDDING_MODEL_PATH=/abs/path/to/embedding/model
# EMBEDDING_MODEL=bge-large-zh-v1.5

# Mode B: OpenAI-compatible embedding API
EMBEDDING_BASE_URL=http://127.0.0.1:8000/v1
EMBEDDING_API_KEY=YOUR_EMBEDDING_API_KEY
EMBEDDING_MODEL=YOUR_EMBEDDING_MODEL

# -----------------------------
# Optional LLM config
# -----------------------------
# Only needed if you plan to extend to agent / eval flows.
QWEN3_API_KEY=YOUR_LLM_API_KEY
QWEN3_BASE_URL=http://127.0.0.1:8001/v1
QWEN3_MODEL=YOUR_LLM_MODEL
